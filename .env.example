# Скопируйте в .env и заполните только то, что используете. Файл .env не попадает в git.
# Ни один ключ не обязателен: базовый сценарий работает на подписке Claude Code.

# Поиск (опционально, если подключаете MCP-сервер поиска вместо встроенного WebSearch)
BRAVE_API_KEY=
# Jev (опционально): дешёвая модель-«решатель» для классификации и оценки вариантов
JEV_API_KEY=
